    {"id": "AB-NESTED-002", "method": "GET", "path": "/lab/secure/projects/202/documents/302", "identity": "alice", "expected_vulnerable": false, "issue_class": "nested-resource authorization", "oracle": "HTTP 403; private marker is not disclosed."},
